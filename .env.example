# ─── Public (safe to expose in the browser) ────────────────────────────────
# Admin chat deep link. Leave blank until you set your real admin username —
# the UI degrades gracefully instead of inventing one.
NEXT_PUBLIC_ADMIN_USERNAME=
# Optional: full https://t.me/... URL that overrides the username above.
NEXT_PUBLIC_ADMIN_URL=
# Public site URL, used for canonical + OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=

# ─── Server only (NEVER prefix these with NEXT_PUBLIC_) ────────────────────
# Bot token from @BotFather. Enables the live support form relay.
TELEGRAM_BOT_TOKEN=
# Chat ID that receives support messages (your user ID or a group ID).
TELEGRAM_CHAT_ID=
# Optional: message thread id for forum groups.
TELEGRAM_MESSAGE_THREAD_ID=